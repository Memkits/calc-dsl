{
  "name": "@memkits/calc-dsl",
  "version": "0.0.10",
  "description": "Calculator DSL in Cirru",
  "main": "./cli.mjs",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "compile": "calcit calcit.cirru",
    "compile-cli": "calcit --entry cli --emit-path cli-out/ calcit.cirru",
    "compile-tests": "calcit calcit.cirru --init-fn calc-dsl.test/run-tests --emit-path test-out/ js",
    "build": "yarn compile && vite build",
    "dev": "yarn compile && vite",
    "release": "yarn build",
    "test:cli": "node --test test/cli.test.mjs"
  },
  "bin": "./cli.mjs",
  "files": [
    "cli.mjs",
    "cli-out/"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:Memkits/calc-dsl.git"
  },
  "author": "jiyinyiyong",
  "license": "MIT",
  "devDependencies": {
    "bottom-tip": "^0.1.5",
    "vite": "8.3.3"
  },
  "dependencies": {
    "@calcit/procs": "0.31.0",
    "@calcit/std": "^0.0.3"
  }
}
