{
  "name": "@memkits/calc-dsl",
  "version": "0.0.8",
  "description": "Calculator DSL in Cirru",
  "main": "./cli.mjs",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "compile": "calcit calcit.cirru js",
    "compile-cli": "calcit --entry cli --emit-path cli-out/ calcit.cirru js",
    "compile-tests": "calcit calcit.cirru --init-fn calc-dsl.test/run-tests --emit-path test-out/ js",
    "build": "yarn compile && vite build",
    "dev": "yarn compile && vite",
    "release": "yarn build",
    "test:cli": "node --test test/cli.test.mjs"
  },
  "bin": "./cli.mjs",
  "repository": {
    "type": "git",
    "url": "git@github.com:mvc-works/calcit-workflow.git"
  },
  "author": "jiyinyiyong",
  "license": "MIT",
  "devDependencies": {
    "bottom-tip": "^0.1.5",
    "feather-icons": "^4.29.1",
    "shortid": "^2.2.16",
    "vite": "8.3.1"
  },
  "dependencies": {
    "@calcit/procs": "0.27.0",
    "@calcit/std": "^0.0.3",
    "dayjs": "^1.11.23"
  }
}
